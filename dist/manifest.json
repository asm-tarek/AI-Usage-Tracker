{
  "manifest_version": 3,
  "name": "AI Usage Tracker",
  "description": "Surfaces provider-native AI subscription usage using your existing signed-in browser session.",
  "version": "0.9.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://claude.ai/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://claude.ai/*"],
    "js": ["claude-bridge.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }, {
    "matches": ["https://chatgpt.com/*"],
    "js": ["chatgpt-bridge.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Usage Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html"
}
